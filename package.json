{
  "name": "bluesky-autoposter",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build:client && node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build:client": "esbuild src/frontend/login.ts --bundle --format=iife --minify --alias:@cedra-labs/wallet-adapter-plugin=./node_modules/@cedra-labs/wallet-adapter-plugin/src/index.ts --outfile=public/login.js",
    "build": "npm run build:client && tsc -p tsconfig.build.json && rm -rf dist/db && cp -r db dist/db",
    "start": "node dist/src/server.js",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "bluesky:check": "node --import tsx src/tools/check-bluesky-session.ts",
    "bluesky:live-test": "node --import tsx src/tools/live-test-post.ts",
    "preprocess-images": "tsx scripts/preprocess-images.ts",
    "migrate-assets-to-object-storage": "tsx scripts/migrate-assets-to-object-storage.ts",
    "lint": "tsc --noEmit && tsc -p src/frontend --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@cedra-labs/ts-sdk": "^2.2.8",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.1.3",
    "@google-cloud/storage": "^7.19.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "google-auth-library": "^10.6.2",
    "image-size": "^2.0.2",
    "nanoid": "^5.1.11",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "sharp": "^0.33.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cedra-labs/wallet-adapter-core": "^5.5.5",
    "@cedra-labs/wallet-adapter-plugin": "^2.4.3",
    "@cedra-labs/wallet-standard": "^0.5.1",
    "@inferenco/nova-wallet-adapter": "^0.1.0",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.25.0",
    "form-data": "^4.0.5",
    "husky": "^9.1.7",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
