{
  "name": "bluesky-autoposter",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "bluesky:check": "tsx src/tools/check-bluesky-session.ts",
    "bluesky:live-test": "tsx src/tools/live-test-post.ts",
    "preprocess-images": "tsx scripts/preprocess-images.ts",
    "migrate-assets-to-object-storage": "tsx scripts/migrate-assets-to-object-storage.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@fastify/basic-auth": "^6.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.1.3",
    "@fastify/view": "^11.1.1",
    "@google-cloud/storage": "^7.19.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.19.0",
    "@types/memoizee": "^0.4.12",
    "@types/passport": "^1.0.17",
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/react": "^5.2.0",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^6.0.1",
    "express-session": "^1.19.0",
    "fastify": "^5.8.5",
    "google-auth-library": "^10.6.2",
    "image-size": "^2.0.2",
    "memoizee": "^0.4.17",
    "nanoid": "^5.1.11",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "sharp": "^0.33.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "form-data": "^4.0.5",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
