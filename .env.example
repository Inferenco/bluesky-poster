# Server
PORT=3000
DATABASE_URL=postgres://poster:poster@localhost:5432/bluesky_poster
# Optional. Only set this to a disposable database whose name includes "test" as its own segment.
# Postgres integration tests truncate this database.
# POSTGRES_TEST_DATABASE_URL=postgres://poster:poster@localhost:5432/bluesky_poster_test

# Dashboard authentication (Cedra wallet)
# Admins are read from the wallet_treasury contract's view functions.
SESSION_SECRET=change-me-to-a-long-random-string
CEDRA_FULLNODE_URL=https://testnet.cedra.dev/v1
ADMIN_CONTRACT_ADDRESS=0xbdf9c94e797716648980ed99a0c6e2b3d6452ce5c1d28dbad3517a9be682b724
ADMIN_CACHE_TTL_MS=60000
ADMIN_VIEW_TIMEOUT_MS=5000
# Set to false for plain-http local development
COOKIE_SECURE=true

# Bluesky worker credentials
BSKY_IDENTIFIER=yourhandle.bsky.social
BSKY_APP_PASSWORD=your-app-password

# Optional
DRY_RUN=true
BSKY_SERVICE_URL=https://bsky.social
ENABLE_NOVA_DRAFTS=false

# Optional AI post suggestions
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_POST_MODEL=gpt-5.4-mini

# Optional Mastodon posting. Only the token is needed for mastodon.social public posts.
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your-mastodon-access-token
MASTODON_VISIBILITY=public

# Only set when you intentionally want `npm run bluesky:live-test` to publish.
# CONFIRM_LIVE_POST=I_UNDERSTAND_THIS_WILL_POST_TO_BLUESKY
# LIVE_TEST_TEXT=Live test from bluesky-poster
