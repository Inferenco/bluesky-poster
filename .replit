entrypoint = "src/server.ts"
run = "npm run dev"
modules = ["nodejs-20", "python-3.11", "postgresql-16"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json"]

[deployment]
build = ["npm", "run", "build"]
run = ["bash", "-c", "PORT=3000 node dist/src/server.js"]
ignorePorts = false
deploymentTarget = "vm"

[[ports]]
localPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "5000"
DRY_RUN = "false"
BSKY_SERVICE_URL = "https://bsky.social"
DASHBOARD_ALLOWED_REPLIT_USERS = "cryptoautistic8,inferenco"

[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0", "javascript_log_in_with_replit:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
